# ============================================================================
# .htaccess — Apache configuration (works on AwardSpace's PHP hosting)
# Keep this conservative: shared hosts vary in what Apache modules they allow,
# so risky rules below are OFF by default and clearly marked.
# ============================================================================

# Default charset
AddDefaultCharset UTF-8

# Default document
DirectoryIndex index.php

# Stop directory listings
Options -Indexes

# --- Force https + non-www -> www (OFF by default) -------------------------
# AwardSpace free plans don't always include a free SSL certificate.
# Once your domain alkhailexpress.com has HTTPS enabled in your AwardSpace
# panel, you can turn this on by removing the "#" from the 3 lines below.
#
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- Basic browser caching for static assets (safe, optional) --------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# --- Compress text assets (safe, optional) ----------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>
